@{ ViewData["Title"] = "Reset password"; }
<h1 class="h3 mb-1">Reset your password</h1>
<p class="text-muted mb-4">Enter your work email. If an account exists, we'll send a reset link that expires in 30 minutes.</p>
<form id="resetForm" class="needs-validation" novalidate>
    <label class="form-label" for="email">Work email</label>
    <input class="form-control mb-3" id="email" type="email" required autocomplete="email" />
    <div class="invalid-feedback mb-2">Enter a valid email.</div>
    <button class="btn btn-primary w-100" type="submit">Send reset link</button>
</form>
<p class="small text-muted text-center mt-4 mb-0"><a asp-action="Login"><i class="bi bi-arrow-left"></i> Back to sign in</a></p>

@section Scripts {
    <script>
        document.getElementById("resetForm").addEventListener("submit", (e) => {
            e.preventDefault();
            if (!e.target.checkValidity()) return;
            nx.toast("If that email has an account, a reset link is on its way (prototype).", "info");
        });
    </script>
}
