@{ ViewData["Title"] = "Set up your workspace"; }
<div class="mb-4">
    <ol class="nx-stepper">
        <li class="done">Account</li>
        <li class="done">Verify email</li>
        <li class="current">Set up</li>
        <li>First job</li>
    </ol>
</div>
<h1 class="h3 mb-1">Set up your workspace</h1>
<p class="text-muted mb-4">A few defaults, all changeable later in Settings.</p>
<div class="d-grid gap-2 mb-4">
    @foreach (var (icon, title, text, ctrl, action, tab) in new[]
    {
        ("bi-building", "Company profile", "Logo, description and careers page URL", "Settings", "Index", "company"),
        ("bi-diagram-3", "Departments", "Engineering, Sales and so on, for hiring teams", "Settings", "Index", "departments"),
        ("bi-person-plus", "Invite your team", "Recruiters and interviewers", "Settings", "Index", "team"),
        ("bi-sliders", "Screening defaults", "Scoring weights and processing options", "Settings", "Index", "screening"),
    })
    {
        <a class="nx-card nx-job-card d-flex align-items-center gap-3 p-3" asp-controller="@ctrl" asp-action="@action" asp-route-tab="@tab">
            <span class="nx-kpi-icon"><i class="bi @icon"></i></span>
            <span class="flex-grow-1"><span class="d-block fw-medium">@title</span><span class="small text-muted">@text</span></span>
            <i class="bi bi-chevron-right text-muted"></i>
        </a>
    }
</div>
<a class="btn btn-primary w-100 btn-lg" asp-controller="Jobs" asp-action="Create">Create your first job</a>
<a class="btn btn-ghost w-100 mt-2" asp-controller="Dashboard" asp-action="Index">Skip to dashboard</a>
