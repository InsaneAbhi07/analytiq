@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Page not found";
}
<div class="container py-5 text-center" style="max-width:560px">
    <div class="display-4 fw-bold text-muted">404</div>
    <h1 class="h4">We couldn't find that page</h1>
    <p class="text-muted">It may have moved, or you may not have access to it.</p>
    <div class="d-flex gap-2 justify-content-center">
        <a class="btn btn-primary" asp-controller="Dashboard" asp-action="Index">Go to dashboard</a>
        <a class="btn btn-outline-secondary" asp-controller="Careers" asp-action="Index">Careers page</a>
    </div>
</div>
