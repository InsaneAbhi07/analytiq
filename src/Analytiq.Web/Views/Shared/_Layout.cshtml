@inject MockDataStore Data
@{
    var isAdmin = (ViewData["Shell"] as string) == "admin";
    var user = Data.CurrentUser;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_Head" />
</head>
<body data-user="@(isAdmin ? "Platform Admin" : user.Name)" data-toast="@TempData["Toast"]" data-toast-variant="@TempData["ToastVariant"]">
    <a class="visually-hidden-focusable position-absolute m-2 btn btn-primary" href="#main">Skip to content</a>
    <div class="nx-app @(isAdmin ? "nx-shell-admin" : "")">
        <aside class="nx-sidebar" aria-label="Main navigation">
            @if (isAdmin)
            {
                <partial name="_AdminSidebar" />
            }
            else
            {
                <partial name="_Sidebar" />
            }
        </aside>
        <div class="nx-sidebar-backdrop"></div>

        <div class="nx-main">
            <header class="nx-topbar">
                <button class="btn btn-ghost btn-icon d-lg-none" type="button" data-sidebar-toggle aria-label="Open navigation"><i class="bi bi-list fs-5"></i></button>
                @if (isAdmin)
                {
                    <form class="nx-search input-icon d-none d-md-block" asp-controller="Admin" asp-action="Companies" method="get" role="search">
                        <i class="bi bi-search"></i>
                        <input id="nxGlobalSearch" name="q" class="form-control" placeholder="Search companies…" aria-label="Search companies" />
                    </form>
                }
                else
                {
                    <form class="nx-search input-icon d-none d-md-block" asp-controller="Candidates" asp-action="Index" method="get" role="search">
                        <i class="bi bi-search"></i>
                        <input id="nxGlobalSearch" name="q" class="form-control" placeholder="Search candidates, skills, jobs…" aria-label="Search candidates" />
                    </form>
                }

                <div class="ms-auto d-flex align-items-center gap-2">
                    <span class="nx-proto-chip d-none d-sm-inline" title="UI prototype: all data is mock and changes are not saved."><i class="bi bi-cone-striped"></i> Prototype · mock data</span>
                    @if (!isAdmin)
                    {
                        <a class="btn btn-primary btn-sm d-none d-sm-inline-flex" asp-controller="Jobs" asp-action="Create"><i class="bi bi-plus-lg"></i> New job</a>
                    }
                    <div class="dropdown">
                        <button class="btn btn-ghost btn-icon position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
                            <i class="bi bi-bell fs-6"></i>
                            <span class="position-absolute top-0 end-0 mt-2 me-2 p-1 bg-danger rounded-circle"><span class="visually-hidden">New notifications</span></span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end nx-notif">
                            <div class="px-3 py-2 border-bottom d-flex justify-content-between align-items-center">
                                <strong class="small">Notifications</strong>
                                <a href="#" class="small" data-toast="All notifications marked as read.">Mark all read</a>
                            </div>
                            @if (isAdmin)
                            {
                                <a class="dropdown-item" asp-controller="Admin" asp-action="Audit"><div class="small fw-medium">Login throttled for admin@orbitlogistics.example</div><div class="small text-muted">5 failed attempts · 2 h ago</div></a>
                                <a class="dropdown-item" asp-controller="Admin" asp-action="Companies"><div class="small fw-medium">Kalpa Health Systems at 90% of resume credits</div><div class="small text-muted">Usage alert · 1 h ago</div></a>
                            }
                            else
                            {
                                <a class="dropdown-item" asp-controller="Candidates" asp-action="Details" asp-route-id="14"><div class="small fw-medium">Resume processing failed for Meera Pillai</div><div class="small text-muted">Product Designer · needs manual review</div></a>
                                <a class="dropdown-item" asp-controller="Interviews" asp-action="Index"><div class="small fw-medium">Interview today 4:00 PM — Neha Gupta</div><div class="small text-muted">Data Scientist — NLP · Round 1</div></a>
                                <a class="dropdown-item" asp-controller="Offers" asp-action="Index"><div class="small fw-medium">Offer to Ishita Banerjee awaiting response</div><div class="small text-muted">Sent 2 days ago</div></a>
                            }
                        </div>
                    </div>
                    <div class="dropdown">
                        <button class="btn btn-ghost d-flex align-items-center gap-2 px-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            @Html.Avatar(isAdmin ? "PA" : user.Initials)
                            <span class="d-none d-md-block text-start lh-sm">
                                <span class="d-block small fw-medium">@(isAdmin ? "Platform Admin" : user.Name)</span>
                                <span class="d-block text-muted" style="font-size:.72rem">@(isAdmin ? "Abhishek Singh" : user.Role)</span>
                            </span>
                            <i class="bi bi-chevron-down small text-muted"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (!isAdmin)
                            {
                                <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index"><i class="bi bi-person me-2"></i>Profile &amp; company</a></li>
                                <li><a class="dropdown-item" asp-controller="Billing" asp-action="Index"><i class="bi bi-credit-card me-2"></i>Billing &amp; usage</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><h6 class="dropdown-header">Prototype: view as</h6></li>
                                <li><a class="dropdown-item" asp-controller="Interviews" asp-action="Mine"><i class="bi bi-person-video3 me-2"></i>Interviewer</a></li>
                                <li><a class="dropdown-item" asp-controller="Careers" asp-action="Index"><i class="bi bi-globe2 me-2"></i>Candidate (careers page)</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="bi bi-shield-lock me-2"></i>Platform Super Admin</a></li>
                            }
                            else
                            {
                                <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-building me-2"></i>Switch to company view (prototype)</a></li>
                            }
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-right me-2"></i>Sign out</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="nx-content" id="main" tabindex="-1">
                @RenderBody()
            </main>
        </div>
    </div>
    <partial name="_Overlays" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
