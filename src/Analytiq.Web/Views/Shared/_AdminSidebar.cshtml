        <span class="nx-brand-mark">N</span>
        <span>Analytiq Platform<small>Super Admin console</small></span>
    </a>
</div>
<div class="nx-tenant">
    <i class="bi bi-shield-lock fs-5" style="color:#fbbf24"></i>
