@model ErrorViewModel
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Something went wrong";
}
<div class="container py-5 text-center" style="max-width:560px">
    <h1 class="h4">Something went wrong</h1>
    <p class="text-muted">The error has been logged. Please try again in a moment.</p>
    @if (Model?.ShowRequestId ?? false)
    {
        <p class="small text-muted">Reference: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" asp-controller="Dashboard" asp-action="Index">Back to dashboard</a>
</div>
